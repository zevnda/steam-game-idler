{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "ignoreCommand": "bash -c 'if git diff HEAD^ HEAD --quiet -- .; then echo \"No changes in docs, skipping build\"; exit 0; else echo \"Changes detected in docs, proceeding with build\"; exit 1; fi'",
  "redirects": [
    {
      "source": "/docs/features/auto-idler",
      "destination": "/docs/features/auto-idle",
      "permanent": true
    },
    {
      "source": "/docs/features/card-farming/account-restrictions",
      "destination": "/docs/features/card-farming/how-it-works#how-to-check-if-your-account-is-restricted",
      "permanent": true
    }
  ]
}
