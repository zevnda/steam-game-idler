    "fumadocs-ui": "^16.17.7",
    "lucide-react": "^0.563.0",
    "motion": "^12.42.2",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
