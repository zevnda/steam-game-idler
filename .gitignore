# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Visual Studio
.vs

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# claude code runtime state - skills/ is carved back out below since it's shared repo tooling
# (e.g. /generate-ui-guide), not local/ephemeral state like scheduled_tasks.lock. Ignoring
# `/.claude/*` (children) rather than `/.claude/` (the directory itself) matters here: excluding
# the directory node outright makes git prune the whole subtree before it ever evaluates the
# negation lines below, so the carve-out would silently do nothing.
/.claude/*
!/.claude/skills/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri
src-tauri/target
src-tauri/libs
src-tauri/gen
.window-state.json

# rust-analyzer
target

# Ad hoc CDP testing scripts (scratch WebSocket-driving scripts written per session) stay untracked.
*.ps1